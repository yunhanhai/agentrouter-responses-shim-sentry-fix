+const ERROR_PATTERNS = [
+  /(?:^|\n)event:\s*error\b/i,
+  /(?:^|\n)data:\s*\{[^\n]*"type"\s*:\s*"response\.failed"/i,
+  /(?:^|\n)data:\s*\{[^\n]*"object"\s*:\s*"error"/i,
+  /(?:^|\n)data:\s*\{[^\n]*"type"\s*:\s*"error"/i,
